node_modules/
web/dist/

# Local run output and capture artifacts, not part of the site
results/
screenshots/

# Everything the deployed site needs is tracked on purpose: demos/**/data.json,
# demos/**/fixtures.json, data/market/** and data/synthetic/** are committed.

# Answers of replaced runs, kept locally for item-by-item comparison. The numbers live in benchmarks/history.json.
benchmarks/runs/

# Secrets and local machine state. The negation stays last: git applies the last
# matching pattern, so a later `.env*` would otherwise re-ignore the example file.
.env
.env.*
.env*
.vercel
!.env.example
