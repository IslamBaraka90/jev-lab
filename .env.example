# TypeSafe API key from https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Optional SDK settings (defaults shown). TYPESAFE_LOG_LEVEL=info logs each request; debug adds bodies.
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_LOG_LEVEL=warn

# Express server port
PORT=3000

# Server address. 127.0.0.1 keeps the dashboard, which can start paid backtests, on this computer only.
# HOST=127.0.0.1

# Where the built site points when it says "run it yourself". Not a secret.
VITE_REPO_URL=https://github.com/IslamBaraka90/jev-typesafe-real-financial-use-cases

# Google Analytics measurement id, for the deployed site only. Left empty on purpose: a clone of this
# repository must not report to somebody else's property, and the code sends nothing without it.
VITE_GA_ID=
